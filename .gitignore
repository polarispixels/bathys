# Secrets: never committed. .env.example is committed and documents every variable.
.env
.env.backup
.env.production
/auth.json

# Dependencies and build output
/vendor
/node_modules
/public/build
/public/hot
/public/storage
/public/fonts-manifest.dev.json
/bootstrap/ssr

# Generated by Wayfinder from the routes (rebuilt on every build)
/resources/js/actions
/resources/js/routes
/resources/js/wayfinder

# Runtime and tool caches
/storage/*.key
/storage/pail
/.phpunit.cache
.phpunit.result.cache
.phpactor.json
npm-debug.log
yarn-error.log
Homestead.json
Homestead.yaml

# Claude Code: personal permissions and worktrees stay local.
# Unlike the starter kit's default, CLAUDE.md, .claude/settings.json,
# .mcp.json, and boost.json ARE committed: they are project documentation
# and shared configuration, not personal preferences. None may hold secrets.
/.claude/settings.local.json
/.claude/worktrees/

# superpowers working files (subagent briefs, progress ledgers, brainstorm scratch)
/.superpowers/

# Other AI agents' local files (not used in this project)
/.agents
/.amp
/.codex
/.cursor
/.factory
/.grok
/.junie
/.kiro
/.pi
/AGENTS.md
/opencode.json
/opencode.jsonc

# Editors and OS
/.fleet
/.idea
/.nova
/.vscode
/.zed
.DS_Store
Thumbs.db
